rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Core Authentication & Multi-Role RBAC Helpers
    // =========================================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isDocOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Owner Super Admin is usahu0304@gmail.com (verified email token)
    function isSuperAdmin() {
      return isSignedIn()
        && ('email' in request.auth.token)
        && ('email_verified' in request.auth.token)
        && request.auth.token.email == "usahu0304@gmail.com"
        && request.auth.token.email_verified == true;
    }

    // Delegated Staff Roles stored in /admin_staff/{uid} or Super Admin
    function isAdmin() {
      return isSuperAdmin()
        || (isSignedIn() && exists(/databases/$(database)/documents/admin_staff/$(request.auth.uid)));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function validStr(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    // =========================================================================
    // 1. User Profiles & Private Student Subcollections
    // =========================================================================
    match /users/{userId} {
      allow get: if isDocOwner(userId) || isAdmin();
      allow list: if isAdmin();

      allow create: if isDocOwner(userId)
        && incoming().userId == userId
        && (
          !('role' in incoming())
          || incoming().role == 'student'
          || (incoming().role in ['admin', 'super_admin'] && isAdmin())
        );

      allow update: if (isDocOwner(userId) || isAdmin())
        && incoming().userId == existing().userId
        && (
          !('role' in incoming())
          || !('role' in existing())
          || incoming().role == existing().role
          || isAdmin()
        );

      allow delete: if isAdmin();

      match /attempts/{attemptId} {
        allow get, list: if isDocOwner(userId) || isAdmin();
        allow create, update: if isDocOwner(userId) || isAdmin();
        allow delete: if isDocOwner(userId) || isAdmin();
      }

      match /purchases/{purchaseId} {
        allow get, list: if isDocOwner(userId) || isAdmin();
        allow create, update: if isDocOwner(userId) || isAdmin();
        allow delete: if isAdmin();
      }

      match /bookmarks/{bookmarkId} {
        allow get, list: if isDocOwner(userId) || isAdmin();
        allow create, update, delete: if isDocOwner(userId) || isAdmin();
      }

      match /mistakes/{mistakeId} {
        allow get, list: if isDocOwner(userId) || isAdmin();
        allow create, update, delete: if isDocOwner(userId) || isAdmin();
      }
    }

    // Delegated Admin Staff directory (Super Admin manages staff roles)
    match /admin_staff/{staffUid} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isSuperAdmin();
    }

    // Collection-group rule allowing Admin to query all purchases & attempts across students
    match /{path=**}/purchases/{purchaseId} {
      allow get, list: if isAdmin();
    }

    match /{path=**}/attempts/{attemptId} {
      allow get, list: if isAdmin();
    }

    // =========================================================================
    // 2. Global App Config & Custom CGpedia Anthem Audio Chunks
    // =========================================================================
    match /app_config/{configId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /anthem_chunks/{chunkId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 3. Multi-Exam Hierarchy: Exams, Subjects, Topics, Folders & Test Series
    // =========================================================================
    match /exams/{examId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /subjects/{subjectId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /topics/{topicId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /subtopics/{subtopicId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /migration_logs/{logId} {
      allow get, list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /exam_folders/{folderId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /subject_folders/{folderId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /testSeries/{seriesId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 4. Tests, Central Question Bank & Bilingual Questions
    // =========================================================================
    match /tests/{testId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();

      match /questions/{questionId} {
        allow get, list: if true;
        allow create, update, delete: if isAdmin();
      }
    }

    match /question_bank/{questionId} {
      allow get, list: if isSignedIn() || true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 5. Test Attempts, Responses, Results & Leaderboard
    // =========================================================================
    match /testAttempts/{attemptId} {
      allow get, list: if isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /testResponses/{responseId} {
      allow get, list: if isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow create, update: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isAdmin();
    }

    match /results/{resultId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /leaderboard/{entryId} {
      allow get, list: if true;
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // =========================================================================
    // 6. Purchases, Orders & Coupons (UPI QR + WhatsApp Verification + Admin Unlock)
    // =========================================================================
    match /purchases/{purchaseId} {
      allow get, list: if isSignedIn() && (resource == null || existing().userId == request.auth.uid || existing().studentEmail == request.auth.token.email || isAdmin());
      allow create, update: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow get, list: if isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 7. Current Affairs, Broadcast Notifications, Announcements & Study Materials
    // =========================================================================
    match /current_affairs/{articleId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() || isSignedIn();
    }

    match /broadcast_notifications/{notificationId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /announcements/{announcementId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /upcoming_tests/{upcomingId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    match /study_materials/{materialId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 8. Private Student Queries & Question Error Reports
    // =========================================================================
    match /student_queries/{queryId} {
      allow get, list: if isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin() || (isSignedIn() && existing().userId == request.auth.uid);
    }

    match /question_reports/{reportId} {
      allow get, list: if isSignedIn() && (resource == null || existing().userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
