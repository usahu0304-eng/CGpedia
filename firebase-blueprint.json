{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated student or owner admin profile with exam preferences, language, dark mode, and notification settings.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Firebase Auth UID of the user." },
        "displayName": { "type": "string", "description": "Student full name." },
        "email": { "type": "string", "description": "Authenticated Google email address." },
        "phoneNumber": { "type": "string", "description": "Student mobile number for exam alerts." },
        "photoUrl": { "type": "string", "description": "Profile avatar URL or local URI." },
        "targetExam": { "type": "string", "description": "Target exam (e.g., CGPSC & CGSSB, CGPSC Prelims, CGSSB Vyapam)." },
        "preferredLanguage": { "type": "string", "enum": ["en", "hi"], "description": "Default UI language preference (en or hi)." },
        "darkMode": { "type": "boolean", "description": "Whether Dark Mode theme is enabled." },
        "notifyCurrentAffairs": { "type": "boolean", "description": "Receive push/local notifications for Current Affairs." },
        "notifyNewTests": { "type": "boolean", "description": "Receive push/local notifications for new Test Series." },
        "role": { "type": "string", "enum": ["student", "admin"], "description": "RBAC role: student or admin (usahu0304@gmail.com only)." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "displayName",
        "email",
        "phoneNumber",
        "photoUrl",
        "targetExam",
        "preferredLanguage",
        "darkMode",
        "notifyCurrentAffairs",
        "notifyNewTests",
        "role",
        "createdAt",
        "updatedAt"
      ]
    },
    "AppConfig": {
      "title": "AppConfig",
      "description": "Global application configuration including CGpedia Anthem audio metadata, Support & Help policy, WhatsApp support, and In-App Update control.",
      "type": "object",
      "properties": {
        "configKey": { "type": "string", "enum": ["global"] },
        "anthemTitleHi": { "type": "string" },
        "anthemTitleEn": { "type": "string" },
        "anthemSourceType": { "type": "string", "enum": ["bundled", "url", "cloud_chunks"] },
        "anthemAudioUrl": { "type": "string" },
        "anthemChunkCount": { "type": "integer" },
        "anthemMimeType": { "type": "string" },
        "telegramChannelUrl": { "type": "string" },
        "supportEmail": { "type": "string" },
        "whatsappSupportNumber": { "type": "string" },
        "supportPolicyHi": { "type": "string" },
        "supportPolicyEn": { "type": "string" },
        "latestVersionCode": { "type": "integer" },
        "latestVersionName": { "type": "string" },
        "apkDownloadUrl": { "type": "string" },
        "updateNotesHi": { "type": "string" },
        "updateNotesEn": { "type": "string" },
        "updatedBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "configKey",
        "anthemTitleHi",
        "anthemTitleEn",
        "anthemSourceType",
        "anthemAudioUrl",
        "anthemChunkCount",
        "anthemMimeType",
        "telegramChannelUrl",
        "supportEmail",
        "updatedBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "AnthemChunk": {
      "title": "AnthemChunk",
      "description": "Base64 encoded audio chunk uploaded from Admin Dashboard for custom CGpedia Anthem playback.",
      "type": "object",
      "properties": {
        "chunkIndex": { "type": "integer" },
        "totalChunks": { "type": "integer" },
        "base64Data": { "type": "string" },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["chunkIndex", "totalChunks", "base64Data", "updatedBy", "updatedAt"]
    },
    "ExamFolder": {
      "title": "ExamFolder",
      "description": "Top-level Exam-Wise folder (e.g., CGPSC Pre 2026 Test Series, CGPSC Prelims, CGSSB/Vyapam).",
      "type": "object",
      "properties": {
        "titleHi": { "type": "string" },
        "titleEn": { "type": "string" },
        "descriptionHi": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "examCode": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "isFreeFolder": { "type": "boolean" },
        "priceInr": { "type": "integer" },
        "validityDays": { "type": "integer" },
        "testCount": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["published", "archived"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleHi",
        "titleEn",
        "descriptionHi",
        "descriptionEn",
        "examCode",
        "sortOrder",
        "isFreeFolder",
        "priceInr",
        "testCount",
        "visibility",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "SubjectFolder": {
      "title": "SubjectFolder",
      "description": "Subject-Wise folder (e.g., Chhattisgarh GS, Indian Polity, History, Economy, Geography, Science, CSAT).",
      "type": "object",
      "properties": {
        "titleHi": { "type": "string" },
        "titleEn": { "type": "string" },
        "descriptionHi": { "type": "string" },
        "descriptionEn": { "type": "string" },
        "subjectCode": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "isFreeFolder": { "type": "boolean" },
        "priceInr": { "type": "integer" },
        "validityDays": { "type": "integer" },
        "testCount": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["published", "archived"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleHi",
        "titleEn",
        "descriptionHi",
        "descriptionEn",
        "subjectCode",
        "sortOrder",
        "isFreeFolder",
        "priceInr",
        "testCount",
        "visibility",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "TestSeriesItem": {
      "title": "TestSeriesItem",
      "description": "Individual Bilingual Test inside an ExamFolder or SubjectFolder, supporting Draft -> Published workflow, Free/Paid monetization, and validity days.",
      "type": "object",
      "properties": {
        "folderType": { "type": "string", "enum": ["exam", "subject"] },
        "folderId": { "type": "string" },
        "titleHi": { "type": "string" },
        "titleEn": { "type": "string" },
        "topic": { "type": "string" },
        "difficulty": { "type": "string", "enum": ["Easy", "Moderate", "Hard", "CGPSC_Level"] },
        "durationMinutes": { "type": "integer" },
        "questionLimit": { "type": "integer" },
        "questionCount": { "type": "integer" },
        "marksPerQuestion": { "type": "number" },
        "negativeMarking": { "type": "number" },
        "isPaid": { "type": "boolean" },
        "priceInr": { "type": "integer" },
        "validityDays": { "type": "integer" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "folderType",
        "folderId",
        "titleHi",
        "titleEn",
        "topic",
        "difficulty",
        "durationMinutes",
        "questionLimit",
        "questionCount",
        "marksPerQuestion",
        "negativeMarking",
        "isPaid",
        "priceInr",
        "status",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "BilingualQuestion": {
      "title": "BilingualQuestion",
      "description": "Bilingual MCQ with 1st language Hindi (Devanagari) and 2nd language English.",
      "type": "object",
      "properties": {
        "testId": { "type": "string" },
        "orderIndex": { "type": "integer" },
        "questionHi": { "type": "string" },
        "questionEn": { "type": "string" },
        "optionsHi": { "type": "array", "items": { "type": "string" } },
        "optionsEn": { "type": "array", "items": { "type": "string" } },
        "correctOptionIndex": { "type": "integer" },
        "explanationHi": { "type": "string" },
        "explanationEn": { "type": "string" },
        "subjectTag": { "type": "string" },
        "visibility": { "type": "string", "enum": ["draft", "published"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "testId",
        "orderIndex",
        "questionHi",
        "questionEn",
        "optionsHi",
        "optionsEn",
        "correctOptionIndex",
        "explanationHi",
        "explanationEn",
        "subjectTag",
        "visibility",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "CurrentAffairItem": {
      "title": "CurrentAffairItem",
      "description": "Bilingual Current Affairs article categorized into chhattisgarh, national, or international.",
      "type": "object",
      "properties": {
        "category": { "type": "string", "enum": ["chhattisgarh", "national", "international"] },
        "headlineHi": { "type": "string" },
        "headlineEn": { "type": "string" },
        "summaryHi": { "type": "string" },
        "summaryEn": { "type": "string" },
        "examKeyPointsHi": { "type": "array", "items": { "type": "string" } },
        "examKeyPointsEn": { "type": "array", "items": { "type": "string" } },
        "sourceName": { "type": "string" },
        "sourceUrl": { "type": "string" },
        "dateLabel": { "type": "string" },
        "visibility": { "type": "string", "enum": ["published", "archived"] },
        "sourceModule": { "type": "string", "enum": ["ai_grounded", "admin_curated"] },
        "authorUid": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "category",
        "headlineHi",
        "headlineEn",
        "summaryHi",
        "summaryEn",
        "examKeyPointsHi",
        "examKeyPointsEn",
        "sourceName",
        "sourceUrl",
        "dateLabel",
        "visibility",
        "sourceModule",
        "authorUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "BroadcastNotification": {
      "title": "BroadcastNotification",
      "description": "Admin broadcast message to all students with rich media support (PDF/Docs, Image, Audio, Video) and Pin capability.",
      "type": "object",
      "properties": {
        "titleHi": { "type": "string" },
        "titleEn": { "type": "string" },
        "messageHi": { "type": "string" },
        "messageEn": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["none", "image", "pdf", "audio", "video"] },
        "mediaUrl": { "type": "string" },
        "mediaTitle": { "type": "string" },
        "isPinned": { "type": "boolean" },
        "visibility": { "type": "string", "enum": ["published", "archived"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleHi",
        "titleEn",
        "messageHi",
        "messageEn",
        "mediaType",
        "mediaUrl",
        "mediaTitle",
        "isPinned",
        "visibility",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "UpcomingTestItem": {
      "title": "UpcomingTestItem",
      "description": "Scheduled upcoming test series announcement posted by Admin.",
      "type": "object",
      "properties": {
        "titleHi": { "type": "string" },
        "titleEn": { "type": "string" },
        "examCategory": { "type": "string" },
        "scheduledDateLabel": { "type": "string" },
        "syllabusSummaryHi": { "type": "string" },
        "syllabusSummaryEn": { "type": "string" },
        "isPaid": { "type": "boolean" },
        "priceInr": { "type": "integer" },
        "validityDays": { "type": "integer" },
        "visibility": { "type": "string", "enum": ["published", "archived"] },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "titleHi",
        "titleEn",
        "examCategory",
        "scheduledDateLabel",
        "syllabusSummaryHi",
        "syllabusSummaryEn",
        "isPaid",
        "priceInr",
        "validityDays",
        "visibility",
        "createdBy",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudentQuery": {
      "title": "StudentQuery",
      "description": "Strictly private student doubt, payment, or technical support query visible only to the submitting student and Admin.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "studentName": { "type": "string" },
        "studentEmail": { "type": "string" },
        "category": { "type": "string", "enum": ["doubt", "payment", "technical"] },
        "subject": { "type": "string" },
        "message": { "type": "string" },
        "adminReply": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "studentName",
        "studentEmail",
        "category",
        "subject",
        "message",
        "adminReply",
        "status",
        "createdAt",
        "updatedAt"
      ]
    },
    "TestAttempt": {
      "title": "TestAttempt",
      "description": "Student exam attempt record with score, accuracy, and per-question responses.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "testId": { "type": "string" },
        "testTitleHi": { "type": "string" },
        "testTitleEn": { "type": "string" },
        "totalQuestions": { "type": "integer" },
        "attemptedCount": { "type": "integer" },
        "correctCount": { "type": "integer" },
        "incorrectCount": { "type": "integer" },
        "score": { "type": "number" },
        "maxScore": { "type": "number" },
        "accuracyPercent": { "type": "integer" },
        "timeTakenSeconds": { "type": "integer" },
        "selectedAnswers": { "type": "object" },
        "status": { "type": "string", "enum": ["submitted"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "testId",
        "testTitleHi",
        "testTitleEn",
        "totalQuestions",
        "attemptedCount",
        "correctCount",
        "incorrectCount",
        "score",
        "maxScore",
        "accuracyPercent",
        "timeTakenSeconds",
        "selectedAnswers",
        "status",
        "createdAt"
      ]
    },
    "PurchaseRecord": {
      "title": "PurchaseRecord",
      "description": "Student purchase/unlock receipt for a Paid Test Series with activation-based validity countdown.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "testId": { "type": "string" },
        "testTitleHi": { "type": "string" },
        "testTitleEn": { "type": "string" },
        "amountInr": { "type": "integer" },
        "paymentMethod": { "type": "string" },
        "transactionRef": { "type": "string" },
        "status": { "type": "string", "enum": ["completed"] },
        "validityDays": { "type": "integer" },
        "expiresAtMillis": { "type": "integer" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "testId",
        "testTitleHi",
        "testTitleEn",
        "amountInr",
        "paymentMethod",
        "transactionRef",
        "status",
        "createdAt"
      ]
    },
    "BookmarkedQuestion": {
      "title": "BookmarkedQuestion",
      "description": "Saved/bookmarked Bilingual MCQ for offline & quick revision.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "questionId": { "type": "string" },
        "testId": { "type": "string" },
        "questionHi": { "type": "string" },
        "questionEn": { "type": "string" },
        "optionsHi": { "type": "array", "items": { "type": "string" } },
        "optionsEn": { "type": "array", "items": { "type": "string" } },
        "correctOptionIndex": { "type": "integer" },
        "explanationHi": { "type": "string" },
        "explanationEn": { "type": "string" },
        "subjectTag": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "userId",
        "questionId",
        "testId",
        "questionHi",
        "questionEn",
        "optionsHi",
        "optionsEn",
        "correctOptionIndex",
        "explanationHi",
        "explanationEn",
        "subjectTag",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private student/admin profile documents."
    },
    "/users/{userId}/attempts/{attemptId}": {
      "schema": { "$ref": "#/entities/TestAttempt" },
      "description": "Student exam attempts."
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": { "$ref": "#/entities/PurchaseRecord" },
      "description": "Unlocked paid test series receipts."
    },
    "/users/{userId}/bookmarks/{bookmarkId}": {
      "schema": { "$ref": "#/entities/BookmarkedQuestion" },
      "description": "Saved bilingual questions for revision."
    },
    "/app_config/{configId}": {
      "schema": { "$ref": "#/entities/AppConfig" },
      "description": "Global application settings and anthem metadata."
    },
    "/anthem_chunks/{chunkId}": {
      "schema": { "$ref": "#/entities/AnthemChunk" },
      "description": "Chunked audio data for custom uploaded CGpedia Anthem."
    },
    "/exam_folders/{folderId}": {
      "schema": { "$ref": "#/entities/ExamFolder" },
      "description": "Exam-Wise test series folders."
    },
    "/subject_folders/{folderId}": {
      "schema": { "$ref": "#/entities/SubjectFolder" },
      "description": "Subject-Wise test series folders."
    },
    "/tests/{testId}": {
      "schema": { "$ref": "#/entities/TestSeriesItem" },
      "description": "Individual tests (Draft/Published, Free/Paid)."
    },
    "/tests/{testId}/questions/{questionId}": {
      "schema": { "$ref": "#/entities/BilingualQuestion" },
      "description": "Bilingual Hindi-English MCQs inside a test."
    },
    "/current_affairs/{articleId}": {
      "schema": { "$ref": "#/entities/CurrentAffairItem" },
      "description": "Bilingual Current Affairs articles (Chhattisgarh, National, International)."
    },
    "/broadcast_notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/BroadcastNotification" },
      "description": "Admin broadcast notifications with Rich Media and Pin support."
    },
    "/upcoming_tests/{upcomingId}": {
      "schema": { "$ref": "#/entities/UpcomingTestItem" },
      "description": "Scheduled upcoming exam test series announcements."
    },
    "/student_queries/{queryId}": {
      "schema": { "$ref": "#/entities/StudentQuery" },
      "description": "Private student queries and Admin support replies."
    }
  }
}
